{
  "name": "yzj",
  "version": "2026.4.9",
  "type": "module",
  "description": "OpenClaw YZJ (Yunzhijia) intelligent bot channel plugin",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "channel": {
      "id": "yzj",
      "label": "YZJ Robot",
      "selectionLabel": "YZJ Robot (plugin)",
      "detailLabel": "YZJ Robot",
      "docsPath": "/channels/yzj",
      "docsLabel": "yzj",
      "blurb": "YunZiJia intelligent bot via HTTP API + webhooks with streaming support.",
      "aliases": [
        "yunzhijia",
        "yzj",
        "云之家",
        "云之家机器人"
      ],
      "order": 90
    },
    "install": {
      "localPath": "extensions/yzj",
      "defaultChoice": "npm"
    }
  },
  "clawdbot": {
    "extensions": [
      "./dist/index.js"
    ],
    "channel": {
      "id": "yzj",
      "label": "YZJ Robot",
      "selectionLabel": "YZJ Robot (plugin)",
      "detailLabel": "YZJ Robot",
      "docsPath": "/channels/yzj",
      "docsLabel": "yzj",
      "blurb": "YunZiJia intelligent bot via HTTP API + webhooks with streaming support.",
      "aliases": [
        "yunzhijia",
        "yzj",
        "云之家",
        "云之家机器人"
      ],
      "order": 90
    },
    "install": {
      "localPath": "extensions/yzj",
      "defaultChoice": "npm"
    }
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@types/ws": "^8.0.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.22"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "files": [
    "openclaw.plugin.json",
    "clawdbot.plugin.json",
    "index.ts",
    "dist/**/*",
    "src/**/*",
    "scripts/**/*",
    "skills/**/*",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./dist/index.js"
    },
    "./src/*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    }
  }
}
